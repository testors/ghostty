msgstr "Navega al resultat de cerca següent, si n'hi ha."

#: src/input/command.zig:219
msgid "Previous Search Result"
msgstr "Resultat de cerca anterior"

#: src/input/command.zig:220
msgid "Navigate to the previous search result, if any."
msgstr "Navega al resultat de cerca anterior, si n'hi ha."

